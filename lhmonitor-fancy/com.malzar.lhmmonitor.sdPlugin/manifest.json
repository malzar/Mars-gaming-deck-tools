{
  "Name": "LHMonitor fancy",
  "Description": "Muestra los datos de Libre Hardware Monitor en tus teclas, rotando entre núcleos, GPUs, discos, ventiladores... 1 clic: cambiar dato · 2 clics: pausa · 3 clics: siguiente.",
  "Author": "Malzar",
  "Version": "1.1.0.0",
  "UUID": "com.malzar.lhmmonitor",
  "SDKVersion": 2,
  "CodePath": "plugin.js",
  "Nodejs": {
    "Version": "20",
    "Debug": "disabled"
  },
  "Icon": "imgs/plugin",
  "Category": "LHMonitor fancy",
  "CategoryIcon": "imgs/category",
  "URL": "https://github.com/LibreHardwareMonitor/LibreHardwareMonitor",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "6.4"
  },
  "Actions": [
    {
      "Name": "CPU",
      "UUID": "com.malzar.lhmmonitor.cpu",
      "Icon": "imgs/act_cpu",
      "Tooltip": "Núcleos de CPU: carga, temperatura y frecuencia",
      "PropertyInspectorPath": "pi/index.html",
      "SupportedInMultiActions": false,
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/key_cpu",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "GPU",
      "UUID": "com.malzar.lhmmonitor.gpu",
      "Icon": "imgs/act_gpu",
      "Tooltip": "Tarjetas gráficas: carga, temperatura, reloj, VRAM",
