{
  "Name": "Prisma",
  "Description": "Prisma, un plugin para controlarlos a todos: los decks Mars Gaming MSD-ONE (familia AKP153) y MSD-PRO (familia AKP05 / N4), y sus clones de Mirabox y Ajazz.",
  "Author": "Malzar",
  "Version": "0.10.0",
  "PluginUUID": "com.malzar.prisma",
  "CodePathWin": "prisma.exe",
  "Icon": "assets/icon",
  "Category": "Prisma",
  "URL": "https://github.com/malzar/prisma-deck",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "HasSettingsInterface": true,
  "Actions": [
    {
      "Name": "Reproducir / Pausa",
      "UUID": "com.malzar.prisma.audio.playpause",
      "Tooltip": "Reproduce o pausa lo que esté sonando (Spotify, navegador, VLC…)",
      "Icon": "assets/actions/playpause",
      "PropertyInspectorPath": "pi/audio.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "assets/actions/playpause",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Detener",
      "UUID": "com.malzar.prisma.audio.stop",
      "Tooltip": "Detiene la reproducción",
      "Icon": "assets/actions/stop",
      "PropertyInspectorPath": "pi/audio.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "assets/actions/stop",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Anterior",
      "UUID": "com.malzar.prisma.audio.prev",
      "Tooltip": "Canción anterior",
      "Icon": "assets/actions/prev",
      "PropertyInspectorPath": "pi/audio.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "assets/actions/prev",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Siguiente",
      "UUID": "com.malzar.prisma.audio.next",
