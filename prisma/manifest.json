      "Encoder": {
        "layout": "layouts/audio-dial.json",
        "Icon": "assets/actions/music-icon",
        "TriggerDescription": {
          "Rotate": "Pista anterior / siguiente",
          "Push": "Reproducir / pausa",
          "Touch": "Reproducir / pausa"
        }
      }
    },
    {
      "Name": "Perfiles (rueda)",
      "UUID": "com.malzar.prisma.profiles",
      "Tooltip": "Gira para recorrer los perfiles del mismo nivel (con vuelta al principio); pulsa para cambiar",
      "Icon": "assets/actions/profiles",
      "PropertyInspectorPath": "pi/profiles.html",
