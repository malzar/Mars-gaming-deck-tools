        "TriggerDescription": {
          "Rotate": "Elegir perfil",
          "Push": "Cambiar",
          "Touch": "Cambiar"
        }
      }
    },
    {
      "Name": "Entrar / cambiar perfil",
      "UUID": "com.malzar.prisma.profilego",
      "Tooltip": "Cambia al perfil elegido con la rueda (o a uno fijo) y entra en sus subperfiles; mantén pulsado para subir un nivel",
      "Icon": "assets/actions/profile-go",
      "PropertyInspectorPath": "pi/profile-go.html",
