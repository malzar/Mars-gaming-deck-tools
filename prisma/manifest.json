      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "assets/actions/next",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Subir volumen",
      "UUID": "com.malzar.prisma.audio.volup",
      "Tooltip": "Sube el volumen general o el de un programa",
      "Icon": "assets/actions/volup",
      "PropertyInspectorPath": "pi/audio.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "assets/actions/volup",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Bajar volumen",
      "UUID": "com.malzar.prisma.audio.voldown",
      "Tooltip": "Baja el volumen general o el de un programa",
      "Icon": "assets/actions/voldown",
      "PropertyInspectorPath": "pi/audio.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "assets/actions/voldown",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Silenciar",
      "UUID": "com.malzar.prisma.audio.mute",
      "Tooltip": "Silencia o quita el silencio del volumen general o de un programa",
      "Icon": "assets/actions/mute",
      "PropertyInspectorPath": "pi/audio.html",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "assets/actions/mute",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "Volumen (rueda)",
      "UUID": "com.malzar.prisma.audio.dial",
      "Tooltip": "Gira para cambiar el volumen general o el de un programa; pulsa para silenciar",
      "Icon": "assets/actions/dial-icon",
      "PropertyInspectorPath": "pi/audio.html",
      "Controllers": [
        "Encoder"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "assets/actions/dial-icon",
          "ShowTitle": false
        }
      ],
      "Encoder": {
        "layout": "layouts/audio-dial.json",
        "Icon": "assets/actions/dial-icon",
        "TriggerDescription": {
          "Rotate": "Volumen",
          "Push": "Silenciar",
          "Touch": "Silenciar"
        }
      }
    },
    {
      "Name": "Música (rueda)",
      "UUID": "com.malzar.prisma.audio.music",
      "Tooltip": "Gira para pasar a la pista siguiente o anterior; pulsa para reproducir o pausar",
      "Icon": "assets/actions/music-icon",
      "PropertyInspectorPath": "pi/audio.html",
      "Controllers": [
        "Encoder"
